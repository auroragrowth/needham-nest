# Copy to .env.local and fill in values.
# Supabase keys: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# Session signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Invoice capture: the till's `invoice-capture` edge function, guarded by the
# shared key in the till's app_settings.invoice_capture_key. Server-side only —
# it must never be exposed to the browser, so no NEXT_PUBLIC_ prefix.
# Deliberately its own variable, not TILL_READ_TOKEN or TILL_STOCK_TOKEN: if this
# link ever leaks it can be rotated on its own without stopping the stock sync.
TILL_CAPTURE_KEY=
# Only needed if the function ever moves; defaults to the till's project.
# TILL_CAPTURE_URL=https://sirmwnwllnarqdaqpzhy.supabase.co/functions/v1/invoice-capture
